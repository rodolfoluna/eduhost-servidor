APP_NAME="EduHost - Hosting Académico"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eduhost
DB_USERNAME=eduhost_admin
DB_PASSWORD=EduHost_Master_2026!

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# =========================================================================
# CONFIGURACIÓN ESPECÍFICA DE EDUHOST (MINI-HOSTING MULTI-ALUMNO)
# =========================================================================
# Ruta donde se alojan las carpetas de los 30 alumnos en el servidor
# En Ubuntu Server: /var/www/students
# En Windows (Pruebas locales): E:/ws/servidor/storage/app/students
STUDENTS_ROOT_PATH=/var/www/students

# Caché compartida de Composer para acelerar 'composer install' en proyectos Laravel de alumnos
COMPOSER_CACHE_DIR=/var/www/composer-cache

# Límite de bases de datos MariaDB que puede crear cada alumno
MAX_DATABASES_PER_STUDENT=5

# Cuota máxima por alumno en MB (por defecto 250 MB)
STUDENT_QUOTA_MB=250

# Ruta pública de Adminer (Gestor visual de BD)
ADMINER_URL=/db-manager/

